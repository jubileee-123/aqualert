# "mock" (default) calls the in-browser mock service directly.
# "http" calls a REST backend at NEXT_PUBLIC_API_BASE_URL using the same contract.
NEXT_PUBLIC_API_MODE=mock

# Base URL for the HTTP client. "/api" uses the bundled Next.js route handlers,
# which serve the same mock data over HTTP. Point this at the real backend later.
NEXT_PUBLIC_API_BASE_URL=/api
